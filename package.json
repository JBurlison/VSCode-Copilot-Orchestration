{
  "name": "vscode-copilot-orchestration",
  "displayName": "Copilot Orchestration",
  "description": "Multi-agent workflows with orchestrator and plan UI for VS Code Copilot",
  "version": "0.0.1",
  "publisher": "jburlison",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "copilot-orchestration.orchestrator",
        "name": "orchestrator",
        "fullName": "Orchestration Agent",
        "description": "Coordinates multiple agents to accomplish complex tasks",
        "isSticky": true
      },
      {
        "id": "copilot-orchestration.requirements",
        "name": "requirements",
        "fullName": "Requirements Builder",
        "description": "Helps gather and structure project requirements",
        "isSticky": true
      }
    ],
    "commands": [
      {
        "command": "copilot-orchestration.showPlanUI",
        "title": "Show Plan Board",
        "category": "Copilot Orchestration"
      },
      {
        "command": "copilot-orchestration.newChatWindow",
        "title": "New Orchestrated Chat",
        "category": "Copilot Orchestration"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "copilot-orchestration.showPlanUI",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^18.x",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2"
  },
  "dependencies": {}
}
